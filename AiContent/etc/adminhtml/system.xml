<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="taimoor" translate="label" sortOrder="900">
            <label>Taimoor</label>
        </tab>
        <section id="taimoor_aicontent" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>AI Content Generator</label>
            <tab>taimoor</tab>
            <resource>Taimoor_AiContent::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="base_url" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>API Base URL</label>
                    <comment>Any OpenAI-compatible API (Gemini, Groq, OpenRouter, Ollama...). Without /chat/completions.</comment>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="30" showInDefault="1">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted. Leave empty for local providers like Ollama.</comment>
                </field>
                <field id="model" translate="label" type="text" sortOrder="40" showInDefault="1">
                    <label>Model</label>
                </field>
                <field id="language" translate="label comment" type="text" sortOrder="50" showInDefault="1">
                    <label>Content Language</label>
                    <comment>For example: English, Arabic, Urdu.</comment>
                </field>
                <field id="tone" translate="label" type="text" sortOrder="60" showInDefault="1">
                    <label>Brand Tone</label>
                </field>
                <field id="overwrite" translate="label comment" type="select" sortOrder="70" showInDefault="1">
                    <label>Overwrite Existing Content</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>No (recommended): only empty fields are filled.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
